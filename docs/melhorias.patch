+/* Telas da revisão de 23/11: Agenda de publicação (js/tela-publicacoes.js), Fontes e integrações (js/tela-fontes.js)
+   e Governança da Maia (js/tela-governanca.js). Usam a base das outras telas (sec-topo, en-kpis, rel-cartao, sec-tabela). */
+.pb-msg { margin: 0; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 10px; background: var(--positivo-fundo); color: var(--positivo); font-weight: 600; font-size: 13px; }
+.pb-form { display: flex; flex-direction: column; gap: 10px; }
+.pb-form label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--texto-2); }
+.pb-form input, .pb-form textarea, .pb-form select { font: inherit; font-size: 14px; color: var(--texto); padding: 8px 10px; border-radius: 10px; border: 1px solid var(--borda); background: var(--cartao); }
+.pb-form-linha { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.pb-canais-form { border: 1px solid var(--borda); border-radius: 10px; padding: 6px 12px; display: flex; flex-wrap: wrap; gap: 0 16px; }
+.pb-canais-form legend { font-size: 12px; color: var(--texto-2); padding: 0 4px; }
+.pb-dica { margin: 0; font-size: 12px; color: var(--texto-2); }
