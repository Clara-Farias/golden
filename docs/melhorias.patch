+  .oc-ct { grid-template-columns: 44px 1fr; }
+  .oc-ct .oc-selo { grid-column: 2; justify-self: start; }
+}
+@media (prefers-reduced-motion: reduce) { .oc-pend-item, .oc-kpi { transition: none; } .oc-pend-item:hover, .oc-kpi:hover { transform: none; } }
+.oc-detalhe { align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; }
+
+/* Regras de alerta e ofício com a Maia (js/orcamento-oficio.js). O diálogo usa a base de css/minha-visao.css. */
+.oc-pend h3 { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
+.oc-pend-acoes { margin-left: auto; display: inline-flex; gap: 6px; }
+.oc-mini-bt { font-size: 12px; padding: 4px 10px; display: inline-flex; align-items: center; gap: 4px; }
+.oc-oficio-bt { margin-top: 4px; }
+.oc-ct-fim { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
+.oc-dlg-corpo { padding: 14px 22px 4px; display: flex; flex-direction: column; gap: 12px; }
+.oc-dlg-sel { display: flex; flex-direction: column; gap: 4px; font-size: 13px; color: var(--texto-2); }
+.oc-dlg-sel select { font: inherit; font-size: 14px; padding: 7px 10px; border-radius: 10px; border: 1px solid var(--borda); background: var(--cartao); color: var(--texto); }
+.oc-oficio { font-family: Georgia, 'Times New Roman', serif; font-size: 15px; line-height: 1.55; color: #1b2528; background: #fffdf8; border: 1px solid #e8e1d2;
+  border-radius: 6px; padding: 26px 30px; box-shadow: 0 6px 18px -10px rgba(0, 0, 0, .25); }
+.oc-oficio p { margin: 0 0 12px; }
+.oc-oficio mark { background: #fff1b8; padding: 0 2px; }
+.oc-of-org { text-align: center; letter-spacing: .04em; }
+.oc-of-ass { text-align: center; margin-top: 26px !important; }
+.oc-of-nota { margin: 0; font-size: 13px; color: var(--texto-2); min-height: 18px; }
+.oc-of-acoes { display: inline-flex; gap: 8px; flex-wrap: wrap; }
+.oc-regras { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
+.oc-regras li { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--borda); border-radius: 12px; font-size: 14px; line-height: 1.9; }
+.oc-regras li.erro { border-color: var(--critica); background: var(--critica-fundo); }
+.oc-regra-campo input { width: 72px; font: inherit; font-weight: 700; text-align: center; padding: 3px 6px; border-radius: 8px; border: 1px solid var(--borda); background: var(--cartao); color: var(--texto); }
+.oc-regra-mudou { font-size: 12px; color: var(--acao); }
+.oc-regra-erro { font-size: 12px; color: var(--critica-texto); font-weight: 600; }
diff -ruN -x __lista_de_arquivos.txt -x melhorias.patch orig/css/perfis-acesso.css work/css/perfis-acesso.css
