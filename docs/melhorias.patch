+        </div>
+        <section class="rel-cartao"><h3>${ic('history')} Publicados <small>últimos 30 dias</small></h3>
+          ${publicados.length ? `<ul class="pb-lista pb-lista-linha">${publicados.slice().reverse().map((p) => cartao(p, { acoes: false })).join('')}</ul>` : '<p class="oc-vazio">Nada publicado nos últimos 30 dias.</p>'}</section>`;
+    }
+
+    el.addEventListener('click', (e) => {
+      const b = e.target.closest('[data-pb]');
+      if (!b || !el.contains(b)) return;
+      const a = b.dataset.pb;
+      const id = b.dataset.pbId;
+      msg = '';
+      if (a === 'novo') { novo = true; desenhar(); const f = el.querySelector('[name="titulo"]'); if (f) f.focus(); return; }
+      if (a === 'cancelar') novo = false;
+      if (a === 'semana') semana = Number(b.dataset.pbS) || 0;
+      if (a === 'aprovar') { api.mudar(id, 'agendado', { aprovadoPor: (GC.usuarioAtual && GC.usuarioAtual() && GC.usuarioAtual().nome) || 'Gabinete' }); msg = 'Aprovado: o post entrou na agenda.'; }
+      if (a === 'descartar') { api.mudar(id, 'descartado'); msg = 'Post descartado.'; }
+      if (a === 'publicar') { api.mudar(id, 'publicado', { quando: agora(), alcance: 0 }); msg = 'Publicado (simulação da demonstração).'; }
+      if (a === 'voltar') { api.mudar(id, 'aprovacao', { aprovadoPor: null }); msg = 'O post voltou para a fila de aprovação.'; }
+      desenhar();
+    });
+    el.addEventListener('submit', (e) => {
+      const f = e.target.closest('[data-pb-form]');
+      if (!f) return;
+      e.preventDefault();
+      const d = new FormData(f);
+      const canaisSel = d.getAll('canal');
+      if (!canaisSel.length) { msg = 'Escolha pelo menos um canal.'; desenhar(); return; }
+      const aprova = podeAprovar();
+      api.criar({ titulo: String(d.get('titulo')).trim(), texto: String(d.get('texto')).trim(), quando: new Date(String(d.get('quando'))).getTime(), area: d.get('area') || null, canais: canaisSel, estado: aprova ? 'agendado' : 'aprovacao', aprovadoPor: aprova ? ((GC.usuarioAtual && GC.usuarioAtual() && GC.usuarioAtual().nome) || 'Gabinete') : null });
+      novo = false;
+      msg = aprova ? 'Post salvo e agendado.' : 'Post salvo: espera a aprovação.';
+      desenhar();
+    });
+    api.ouvir(() => { if (!el.hidden) desenhar(); });
+    return { mostrar() { desenhar(); }, atualizar() { /* a agenda só muda pelos próprios botões ou pela Maia (ouvir) */ } };
+  };
+})(window.GC = window.GC || {});
diff -ruN -x __lista_de_arquivos.txt -x melhorias.patch orig/js/visao-simples.js work/js/visao-simples.js
--- orig/js/visao-simples.js	1969-12-31 21:00:00.000000000 -0300
+++ work/js/visao-simples.js	2026-11-23 11:11:50.038528403 -0300
@@ -0,0 +1,66 @@
+(function (GC) {
+  // Visão resumida × visão completa (workshop de 18/11: "opções de navegação mais enxutas ou alternância entre
+  // visões simples e complexas, para gestores com diferentes perfis e familiaridade com tecnologia").
+  // A visão resumida é o mesmo painel (mapa, cabeçalho, menu, doca e telas), com menos informação:
+  //   - o "Resumo de hoje" aberto sobre o mapa (js/resumo-essencial.js);
+  //   - o menu com as telas de acompanhamento (GC.TELAS_VISAO_SIMPLES), cada uma resumida (js/resumo-telas.js);
+  //   - sem filtros, camadas, visualizações salvas, widgets no mapa e itens de administração (css/visao-simples.css);
+  //   - Plano de governo por eixo e Orçamento sem o detalhe de recursos, contratos e licitações.
+  // Quem decide como o painel abre é o perfil de acesso (GC.EXIBICOES em js/permissoes.js, editável em Usuários e
+  // permissões → Perfis): completa, resumida ou só resumida. Nas duas primeiras a pessoa troca pelo pé do menu, e a
+  // escolha fica neste navegador, por usuário (vd-visao.<usuário>). Em "só resumida" não há troca.
+  const chave = () => {
+    let u = null;
+    try { u = typeof GC.usuarioAtual === 'function' ? GC.usuarioAtual() : null; } catch (e) { u = null; }
+    return `vd-visao.${u ? u.id : 'demo'}`;
+  };
+  const ler = () => { try { return localStorage.getItem(chave()); } catch (e) { return null; } };
+  const gravar = (v) => { try { localStorage.setItem(chave(), v); } catch (e) { /* sem armazenamento: vale até recarregar */ } };
+  // Destinos do menu na visão resumida (pela tela da rota). Desde a revisão de 19/11 a visão resumida não corta
+  // módulos: todas as telas de acompanhamento ficam, cada uma resumida (js/resumo-telas.js). Só o Cruzamento de
+  // dados (ferramenta de análise) fica para a visão completa. 'secretaria' é a "Minha secretaria" do setor.
+  GC.TELAS_VISAO_SIMPLES = ['painel', 'crise', 'secretarias', 'secretaria', 'relatorios', 'sazonal', 'entregas', 'metas', 'orcamento', 'tarefas', 'alertas', 'indicadores', 'publicacoes', 'governanca', 'fontes'];
+
+  // O perfil em uso (com o "Vendo como" da URL, se houver).
+  function papelAtual() {
+    try { return GC.papelDe ? GC.papelDe(GC.perfil) : null; } catch (e) { return null; }
+  }
+  const exibicao = () => { const p = papelAtual(); return (p && GC.EXIBICOES && GC.EXIBICOES[p.exibicao]) ? p.exibicao : 'completa'; };
+  const forcada = () => exibicao() === 'so_resumida';
+  function ligada() {
+    if (GC.visaoDe && GC.visaoDe(GC.perfil) === 'portal') return false;
+    if (forcada()) return true;
+    // Minha visão (js/minha-visao.js), quando a pessoa já salvou a dela: o mapa simples é a visão resumida.
+    const mv = GC.minhaVisao && GC.minhaVisao.salva();
+    if (mv && mv.mapa) return mv.mapa === 'simples';
+    const guardada = ler();
+    if (guardada === 'simples') return true;
+    if (guardada === 'completa') return false;
+    return exibicao() === 'resumida';
+  }
+
+  function aplicar() { document.documentElement.classList.toggle('visao-simples', ligada()); }
+
+  GC.visaoSimples = {
+    ligada,
+    forcada,
+    exibicao,
+    alternar(valor) {
+      if (forcada()) return;
+      const simples = valor === undefined ? !ligada() : valor;
+      gravar(simples ? 'simples' : 'completa');
+      // A troca rápida do pé do menu vira um modelo da Minha visão (Resumida ou Completa).
+      if (GC.minhaVisao) GC.minhaVisao.definir({ mapa: simples ? 'simples' : 'completo', arrumacao: 'padrao', blocos: {} });
+      aplicar();
+      // O menu e a doca são montados uma vez: recarregar é o jeito simples e sem resto de estado.
+      window.location.reload();
+    },
+    // Filtra os itens do menu (js/dashboard.js) na visão resumida.
+    menu(itens) {
+      const fora = (i) => !!(GC.minhaVisao && i.rota && GC.minhaVisao.ocultaNoMenu(i.rota.tela));
+      if (!ligada()) return itens.filter((i) => !fora(i));
+      return itens.filter((i) => !i.grupo && GC.TELAS_VISAO_SIMPLES.includes(i.rota.tela) && !fora(i));
+    },
+    aplicar,
+  };
+})(window.GC = window.GC || {});
diff -ruN -x __lista_de_arquivos.txt -x melhorias.patch orig/js/voz.js work/js/voz.js
--- orig/js/voz.js	1969-12-31 21:00:00.000000000 -0300
+++ work/js/voz.js	2026-11-23 11:14:54.577143324 -0300
@@ -0,0 +1,145 @@
+(function (GC) {
+  // Falar com a Maia (workshop de 18/11: "conversão de voz em texto para facilitar a interação por meio da
+  // assistente"). Um botão de microfone ao lado do campo de cada conversa com a Maia: painel (#chat-form), Portal do
+  // Cidadão (#p-maia-form) e portal do servidor (#sv-maia-form). Usa o reconhecimento de fala do próprio navegador
+  // (Web Speech API, pt-BR): o texto aparece no campo enquanto a pessoa fala e é enviado quando ela para.
+  // Navegador sem reconhecimento (Firefox, por exemplo): o botão não aparece. Nada é gravado nem sai do aparelho
+  // pelo painel; o reconhecimento é o do navegador.
+  const Reconhecimento = window.SpeechRecognition || window.webkitSpeechRecognition;
+  GC.vozDisponivel = !!Reconhecimento;
+  const FORMS = ['#chat-form', '#p-maia-form', '#sv-maia-form'];
+
+  function ligar(form) {
+    if (!form || form.querySelector('.btn-voz')) return;
+    const campo = form.querySelector('input[type="text"], input:not([type]), textarea');
+    if (!campo) return;
+    const b = document.createElement('button');
+    b.type = 'button';
+    b.className = 'btn-voz';
+    b.title = 'Falar com a Maia (a fala vira texto)';
+    b.setAttribute('aria-label', 'Falar com a Maia');
+    b.setAttribute('aria-pressed', 'false');
+    b.innerHTML = '<i class="ti ti-microphone" aria-hidden="true"></i>';
+    const enviar = form.querySelector('button[type="submit"]');
+    form.insertBefore(b, enviar || null);
+
+    let rec = null;
+    let antes = '';
+    function parar() { if (rec) { try { rec.stop(); } catch (e) { /* já parou */ } } }
+    function estado(ouvindo) {
+      b.classList.toggle('ouvindo', ouvindo);
+      b.setAttribute('aria-pressed', String(ouvindo));
+      b.innerHTML = `<i class="ti ti-${ouvindo ? 'player-stop' : 'microphone'}" aria-hidden="true"></i>`;
+      b.title = ouvindo ? 'Parar de ouvir' : 'Falar com a Maia (a fala vira texto)';
+      campo.placeholder = ouvindo ? 'Ouvindo… pode falar' : (campo.dataset.placeholderVoz || campo.placeholder);
+    }
+    b.addEventListener('click', () => {
+      if (rec) { parar(); return; }
+      if (!Reconhecimento) return;
+      campo.dataset.placeholderVoz = campo.placeholder;
+      antes = campo.value ? `${campo.value.trim()} ` : '';
+      rec = new Reconhecimento();
+      rec.lang = 'pt-BR';
+      rec.interimResults = true;
+      rec.continuous = false;
+      let final = '';
+      rec.onresult = (ev) => {
+        let parcial = '';
+        for (let i = ev.resultIndex; i < ev.results.length; i += 1) {
+          if (ev.results[i].isFinal) final += ev.results[i][0].transcript;
+          else parcial += ev.results[i][0].transcript;
+        }
+        campo.value = (antes + final + parcial).trim();
+      };
+      rec.onerror = (ev) => {
+        if (ev.error === 'not-allowed' || ev.error === 'service-not-allowed') campo.placeholder = 'Libere o microfone no navegador para falar com a Maia';
+      };
+      rec.onend = () => {
+        rec = null;
+        estado(false);
+        // Falou alguma coisa: envia como se a pessoa tivesse apertado Enter.
+        if (final.trim()) {
+          if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
+        }
+      };
+      estado(true);
+      try { rec.start(); } catch (e) { rec = null; estado(false); }
+    });
+  }
+
+  // ---- A Maia responde em voz (pauta do Paulo Fiuza, item 2) ----
+  // Um botão de alto-falante ao lado do microfone liga e desliga. Ligado, cada resposta nova da Maia é lida em voz
+  // alta (Web Speech, voz em português do próprio aparelho), quando a resposta termina de aparecer. A escolha fica no
+  // aparelho (gc.maia.voz). Só o texto da resposta é lido: botões, gráficos e o nome "Maia" ficam de fora.
+  const fala = typeof window !== 'undefined' && 'speechSynthesis' in window && typeof SpeechSynthesisUtterance === 'function';
+  const CONVERSAS = [
+    { form: '#chat-form', log: '#chat-mensagens', msg: '.msg.ia', texto: (m) => m },
+    { form: '#p-maia-form', log: '#p-maia-log', msg: '.pm-dela', texto: (m) => m.querySelector('.pm-balao') || m },
+    { form: '#sv-maia-form', log: '#sv-maia-log', msg: '.sv-maia-msg.dela', texto: (m) => m.querySelector('.sv-maia-balao') || m },
+  ];
+  const CHAVE_FALA = 'gc.maia.voz';
+  let falaLigada = (() => { try { return localStorage.getItem(CHAVE_FALA) === '1'; } catch (e) { return false; } })();
+  const lidas = new WeakSet();
+  function textoLimpo(el) {
+    const c = el.cloneNode(true);
+    c.querySelectorAll('button, .autor, canvas, svg, .maia-rosto, .pm-mapa, .msg-acoes, .chat-grafico, table, .sv-maia-opcoes').forEach((x) => x.remove());
+    return c.textContent.replace(/\s+/g, ' ').trim().slice(0, 700);
+  }
+  function falar(t) {
+    if (!fala || !t) return;
+    const u = new SpeechSynthesisUtterance(t);
+    u.lang = 'pt-BR';
+    u.rate = 1;
+    const voz = window.speechSynthesis.getVoices().find((v) => /^pt(-|_)BR/i.test(v.lang));
+    if (voz) u.voice = voz;
+    window.speechSynthesis.cancel();
+    window.speechSynthesis.speak(u);
+  }
+  function marcarBotoes() {
+    document.querySelectorAll('.btn-ouvir').forEach((b) => {
+      b.setAttribute('aria-pressed', String(falaLigada));
+      b.title = falaLigada ? 'A Maia está lendo as respostas em voz alta. Clique para desligar.' : 'Ouvir as respostas da Maia em voz alta';
+      b.innerHTML = `<i class="ti ti-${falaLigada ? 'volume' : 'volume-off'}" aria-hidden="true"></i>`;
+    });
+  }
+  function ligarFala(cfg) {
+    const form = document.querySelector(cfg.form);
+    const log = document.querySelector(cfg.log);
+    if (!fala || !form || !log || form.querySelector('.btn-ouvir')) return;
+    const b = document.createElement('button');
+    b.type = 'button';
+    b.className = 'btn-voz btn-ouvir';
+    b.setAttribute('aria-label', 'Ouvir as respostas da Maia em voz alta');
+    const antesDe = form.querySelector('.btn-voz') || form.querySelector('button[type="submit"]');
+    form.insertBefore(b, antesDe || null);
+    b.addEventListener('click', () => {
+      falaLigada = !falaLigada;
+      try { localStorage.setItem(CHAVE_FALA, falaLigada ? '1' : '0'); } catch (e) { /* vale até recarregar */ }
+      if (!falaLigada) window.speechSynthesis.cancel();
+      marcarBotoes();
+      // Ligou: lê a última resposta, para a pessoa ouvir como fica.
+      if (falaLigada) { const ult = [...log.querySelectorAll(cfg.msg)].pop(); if (ult) { lidas.add(ult); falar(textoLimpo(cfg.texto(ult))); } }
+    });
+    // As respostas que já estavam na tela (conversa restaurada) não são lidas.
+    log.querySelectorAll(cfg.msg).forEach((m) => lidas.add(m));
+    let espera = null;
+    new MutationObserver(() => {
+      clearTimeout(espera);
+      // Espera a resposta terminar de aparecer (a Maia escreve aos poucos).
+      espera = setTimeout(() => {
+        const novas = [...log.querySelectorAll(cfg.msg)].filter((m) => !lidas.has(m) && !m.classList.contains('msg-restaurada'));
+        novas.forEach((m) => lidas.add(m));
+        if (falaLigada && novas.length) falar(textoLimpo(cfg.texto(novas[novas.length - 1])));
+      }, 900);
+    }).observe(log, { childList: true, subtree: true, characterData: true });
+    marcarBotoes();
+  }
+  GC.maiaVoz = { ligada: () => falaLigada, falar, textoLimpo };
+
+  function iniciar() {
+    if (GC.vozDisponivel) FORMS.forEach((s) => ligar(document.querySelector(s)));
+    CONVERSAS.forEach(ligarFala);
+  }
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
+  else iniciar();
+})(window.GC = window.GC || {});
